rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Snapshots: Open read for all users, write for server or authenticated
    match /snapshots/{snapshotId} {
      allow read: if true;
      allow write: if true;
    }

    // Prediction audit tracking records
    match /prediction_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // User Price Alerts
    match /price_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    // Flight schedules & airline catalog
    match /flight_catalog/{flightId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications log
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Daily AI Briefings (persisted once per calendar day)
    match /daily_ai_briefings/{briefingId} {
      allow read: if true;
      allow write: if true;
    }

    // Phase 3 Model Registry
    match /model_registry/{modelId} {
      allow read: if true;
      allow write: if true;
    }

    // Phase 3 Shadow Predictions
    match /shadow_predictions/{shadowId} {
      allow read: if true;
      allow write: if true;
    }

    // Phase 3 Dataset Manifests
    match /dataset_manifests/{manifestId} {
      allow read: if true;
      allow write: if true;
    }

    // Phase 4 Sequential Decision Collections
    match /decision_episodes/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /recommendation_versions/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /state_transition_observations/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /recommendation_transitions/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /opportunity_labels/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /downside_recovery_labels/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /market_outcomes/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /policy_outcomes/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /shadow_notifications/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /task_readiness_reports/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /collection_attempts/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /experimental_provider_observations/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /provider_comparisons/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
