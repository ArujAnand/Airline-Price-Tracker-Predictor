# GEMINI_API_KEY: Primary key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_SECONDARY or GEMINI_API_KEY_2: Optional secondary fallback key for Gemini AI.
# If provided in Secrets, the app will automatically pool or failover across both keys.
GEMINI_API_KEY_SECONDARY=""
GEMINI_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SERPAPI_API_KEY: Optional SerpApi key for Google Flights JSON engine.
# If omitted, the built-in direct Google Flights live scraper is used automatically.
SERPAPI_API_KEY=""

# SEARCHAPI_API_KEY: Optional SearchApi.io key for Google Flights engine.
SEARCHAPI_API_KEY=""

# FIREBASE CONFIGURATION: Configure in Render Environment Variables to avoid checking keys into Git
FIREBASE_PROJECT_ID="gen-lang-client-0517156539"
FIREBASE_DATABASE_ID="ai-studio-flightpricetrend-46e45fb1-7c70-4b83-96d5-d1f852bc4638"
FIREBASE_API_KEY=""
FIREBASE_APP_ID=""
FIREBASE_AUTH_DOMAIN="gen-lang-client-0517156539.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0517156539.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="988690852431"
